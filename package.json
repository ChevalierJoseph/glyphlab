{
  "name": "glyphlab-vecto-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat minimal qui dessine des lettres en vecto (SVG) via l'API Mistral et le SDK TypeScript officiel.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mistralai/mistralai": "^1.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
